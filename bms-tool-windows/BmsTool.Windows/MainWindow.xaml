<Window x:Class="BmsTool.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BMS Assistant" Height="880" Width="1240" MinHeight="720" MinWidth="1040">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="10" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="ScanButton" Grid.Column="0" Width="86" Margin="0,0,8,0" Click="ScanButton_Click">扫描设备</Button>
                <Button x:Name="StopScanButton" Grid.Column="1" Width="70" Margin="0,0,8,0" Click="StopScanButton_Click">停止</Button>
                <ComboBox x:Name="DeviceList" Grid.Column="2" Height="30"/>
                <Button x:Name="ConnectButton" Grid.Column="3" Width="90" Margin="8,0" Click="ConnectButton_Click">连接 BMS</Button>
                <TextBlock x:Name="ConnectionText" Grid.Column="4" VerticalAlignment="Center" Text="未连接" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="0,10,0,0">
            <TabItem Header="电池状态">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="AutoRefreshText" VerticalAlignment="Center" Text="连接后自动刷新" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LastUpdateText" Margin="18,0,0,0" VerticalAlignment="Center" Text="未读取"/>
                        </StackPanel>

                        <UniformGrid Columns="4" Margin="0,14,0,0">
                            <GroupBox Header="总压" Margin="4"><TextBlock x:Name="PackVoltageText" FontSize="26" FontWeight="Bold" Margin="10" Text="—"/></GroupBox>
                            <GroupBox Header="电流" Margin="4"><TextBlock x:Name="CurrentText" FontSize="26" FontWeight="Bold" Margin="10" Text="—"/></GroupBox>
                            <GroupBox Header="SOC / SOH" Margin="4"><TextBlock x:Name="SocText" FontSize="22" Margin="10" Text="—"/></GroupBox>
                            <GroupBox Header="工作状态" Margin="4"><TextBlock x:Name="WorkStateText" FontSize="22" FontWeight="SemiBold" Margin="10" Text="—"/></GroupBox>
                        </UniformGrid>

                        <UniformGrid Columns="3" Margin="0,8,0,0">
                            <GroupBox Header="MOS 状态" Margin="4">
                                <TextBlock x:Name="MosStateText" Margin="10" FontSize="16" Text="—" TextWrapping="Wrap"/>
                            </GroupBox>
                            <GroupBox Header="系统功能状态" Margin="4">
                                <TextBlock x:Name="SystemStateText" Margin="10" FontSize="15" Text="—" TextWrapping="Wrap"/>
                            </GroupBox>
                            <GroupBox Header="保护状态" Margin="4">
                                <StackPanel Margin="10">
                                    <TextBlock x:Name="ProtectionSummaryText" FontSize="20" FontWeight="Bold" Text="—"/>
                                    <TextBlock x:Name="ProtectionLevelsText" Margin="0,6,0,0" FontSize="14" Text="—" TextWrapping="Wrap"/>
                                </StackPanel>
                            </GroupBox>
                        </UniformGrid>

                        <UniformGrid Columns="3" Margin="0,8,0,0">
                            <GroupBox Header="温度" Margin="4"><TextBlock x:Name="TempsText" FontSize="17" Margin="10" Text="—" TextWrapping="Wrap"/></GroupBox>
                            <GroupBox Header="单体极值" Margin="4"><TextBlock x:Name="CellExtremeText" Margin="10" Text="—" TextWrapping="Wrap"/></GroupBox>
                            <GroupBox Header="容量 / 循环" Margin="4"><TextBlock x:Name="CapacityText" Margin="10" Text="—" TextWrapping="Wrap"/></GroupBox>
                        </UniformGrid>

                        <GroupBox Header="单体电压" Margin="4,12,4,4">
                            <TextBlock x:Name="CellsText" Margin="10" FontSize="15" Text="—" TextWrapping="Wrap"/>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="保护 / BMS 参数">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="保护参数修改后会立即写入设备并保存。请确认参数符合当前电池规格。" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,8">
                            <Button Width="105" Click="ReadProtection_Click">读取全部</Button>
                            <Button Width="115" Margin="8,0,0,0" Click="WriteSelectedProtection_Click">写入选中项</Button>
                            <Button Width="135" Margin="8,0,0,0" Click="WriteChangedProtection_Click">写入全部修改项</Button>
                            <TextBlock x:Name="ProtectionStatusText" Margin="14,0,0,0" VerticalAlignment="Center" Text="未读取"/>
                        </StackPanel>
                    </StackPanel>

                    <DataGrid x:Name="ProtectionGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Single" SelectionUnit="FullRow" Margin="0,0,0,10" IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="保护项" Binding="{Binding Group}" Width="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="参数" Binding="{Binding Stage}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="当前值" Binding="{Binding DeviceDisplayValue}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="修改值" Binding="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                            <DataGridTextColumn Header="单位 / 说明" Binding="{Binding Hint}" Width="*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <GroupBox Grid.Row="2" Header="BMS 参数">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock FontWeight="SemiBold" Text="SOC 校准"/>
                                <TextBlock x:Name="CurrentSocParamText" Margin="0,5,0,8" Text="当前 SOC：—"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="SocSetBox" Width="100" Height="28" Text="60"/>
                                    <TextBlock VerticalAlignment="Center" Margin="6,0">%</TextBlock>
                                    <Button Width="115" Margin="10,0,0,0" Click="WriteSocParameter_Click">写入并校验</Button>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock FontWeight="SemiBold" Text="循环次数"/>
                                <TextBlock x:Name="CurrentCycleParamText" Margin="0,5,0,8" Text="当前循环次数：—"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="CycleSetBox" Width="100" Height="28" Text="0"/>
                                    <Button Width="115" Margin="10,0,0,0" Click="WriteCycleParameter_Click">写入并校验</Button>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="BmsParamResultText" Grid.ColumnSpan="2" Margin="0,46,0,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="设备信息 / 蓝牙名">
                <StackPanel Margin="16">
                    <Button Width="120" HorizontalAlignment="Left" Click="RefreshIdentity_Click">刷新设备信息</Button>
                    <TextBlock x:Name="IdentityText" Margin="0,14,0,20" FontSize="15" Text="—"/>
                    <GroupBox Header="修改蓝牙名">
                        <StackPanel Margin="12">
                            <TextBlock Text="设备名称固定以 BT_ 开头。此处只填写后缀，支持字母、数字、下划线和短横线。" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock VerticalAlignment="Center" FontSize="16" Text="BT_"/>
                                <TextBox x:Name="NameSuffixBox" Width="240" Height="30" Margin="4,0,10,0"/>
                                <Button Width="110" Click="WriteName_Click">写入并确认</Button>
                                <TextBlock x:Name="BtNameResultText" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <TabItem Header="OTA 升级">
                <StackPanel Margin="16">
                    <StackPanel Orientation="Horizontal">
                        <Button Width="100" Click="BrowseFirmware_Click">选择 BIN</Button>
                        <TextBlock x:Name="FirmwareText" Margin="12,0,0,0" VerticalAlignment="Center" Text="未选择固件"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock VerticalAlignment="Center">传输模式</TextBlock>
                        <ComboBox x:Name="OtaModeBox" Width="170" Margin="8,0">
                            <ComboBoxItem Content="Auto" Tag="Auto" IsSelected="True"/>
                            <ComboBoxItem Content="Legacy Fast (16B)" Tag="LegacyFast"/>
                            <ComboBoxItem Content="Extend 64B" Tag="Extend64"/>
                        </ComboBox>
                        <TextBlock VerticalAlignment="Center" Margin="20,0,0,0">目标软件版本（可选）</TextBlock>
                        <TextBox x:Name="ExpectedVersionBox" Width="180" Margin="8,0"/>
                    </StackPanel>
                    <TextBlock Margin="0,10,0,0" Text="升级完成后会自动等待设备重启、重新连接并读取电池数据，确认新程序已经正常运行。填写目标版本时还会进行版本一致性校验。" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="OtaProgressBar" Height="24" Margin="0,18,0,0" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="OtaProgressText" Margin="0,6,0,0" Text="Idle"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="StartOtaButton" Width="110" Click="StartOta_Click">开始 OTA</Button>
                        <Button x:Name="CancelOtaButton" Width="90" Margin="10,0,0,0" IsEnabled="False" Click="CancelOta_Click">取消</Button>
                    </StackPanel>
                    <TextBlock x:Name="OtaVerifyText" Margin="0,18,0,0" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="专业调试">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="原始寄存器读写">
                        <StackPanel Margin="10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center">地址</TextBlock>
                                <TextBox x:Name="ManualAddressBox" Width="100" Margin="8,0" Text="0xD120"/>
                                <TextBlock VerticalAlignment="Center">数量</TextBlock>
                                <TextBox x:Name="ManualQuantityBox" Width="70" Margin="8,0" Text="11"/>
                                <Button Width="90" Click="ManualRead_Click">读取</Button>
                                <TextBlock VerticalAlignment="Center" Margin="24,0,0,0">写地址</TextBlock>
                                <TextBox x:Name="DebugWriteAddressBox" Width="100" Margin="8,0" Text="0x1005"/>
                                <TextBlock VerticalAlignment="Center">值</TextBlock>
                                <TextBox x:Name="DebugWriteValueBox" Width="90" Margin="8,0" Text="60"/>
                                <Button Width="110" Click="DebugWriteRegister_Click">写入寄存器</Button>
                            </StackPanel>
                            <TextBox x:Name="RegisterOutput" Margin="0,10,0,0" Height="120" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                            <TextBlock x:Name="DebugRawStatusText" Margin="0,8,0,0" FontFamily="Consolas" TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="1" Header="诊断日志" Margin="0,10,0,0">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="LogPathText" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button Grid.Column="1" Width="110" Margin="8,0" Click="OpenLogFolder_Click">打开日志目录</Button>
                            <Button Grid.Column="2" Width="90" Click="ClearLogView_Click">清空显示</Button>
                        </Grid>
                    </GroupBox>

                    <TextBox x:Name="LogBox" Grid.Row="2" Margin="0,10,0,0" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
