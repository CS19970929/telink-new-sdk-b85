<Window x:Class="BmsTool.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BMS Assistant" Height="900" Width="1360" MinHeight="600" MinWidth="900"
        Background="#F3F3F3" Loaded="CustomerUi_Loaded">
    <Window.Resources>
        <Style x:Key="CustomerGroupBox" TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#C8C8C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="CustomerValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="CustomerButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Padding" Value="10,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <TabControl x:Name="MainTabs">
            <TabItem x:Name="RealtimeTab" Header="实时监控">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Margin="5,4,5,3" Padding="8,4" BorderBrush="#CDCDCD" BorderThickness="1" Background="White">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="长期监控" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="记录间隔" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="HomeRecordIntervalBox" Width="82" Height="28" Margin="0,2,10,2"
                                      AutomationProperties.Name="记录间隔"/>
                            <Button x:Name="HomeRecordStartButton" Style="{StaticResource CustomerButton}" Margin="0,2,6,2">开始监控</Button>
                            <Button x:Name="HomeRecordStopButton" Style="{StaticResource CustomerButton}" Margin="0,2,6,2">停止</Button>
                            <Button x:Name="HomeRecordExportButton" Style="{StaticResource CustomerButton}" Margin="0,2,6,2">导出 CSV / Excel</Button>
                            <TextBlock x:Name="HomeRecordStatusText" Text="未开始" VerticalAlignment="Center" Foreground="DimGray"
                                       MaxWidth="340" TextTrimming="CharacterEllipsis"/>
                        </WrapPanel>
                    </Border>
                    <ScrollViewer x:Name="RealtimeScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <Grid MinHeight="620" Height="{Binding ViewportHeight, ElementName=RealtimeScrollViewer}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="35*"/>
                                <ColumnDefinition Width="27*"/>
                                <ColumnDefinition Width="38*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: cell voltages -->
                            <GroupBox Grid.Row="0" Grid.Column="0" Header="单体电压(mV)" Style="{StaticResource CustomerGroupBox}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="76"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="4,0,4,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="最高电压" Width="60" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="CustomerMaxCellText" Foreground="Red" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Text="—"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="最低电压" Width="60" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="CustomerMinCellText" Foreground="Green" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Text="—"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="平均电压" Width="60" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="CustomerAvgCellText" VerticalAlignment="Center" Text="—"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="最大压差" Width="60" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="CustomerDeltaCellText" VerticalAlignment="Center" Text="—"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="有效串数" Width="60" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="CustomerCellCountText" VerticalAlignment="Center" Text="—"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="OwcCellStatusText" Grid.Row="1" Margin="4,0,4,6" TextWrapping="Wrap"
                                               Foreground="DimGray" Visibility="Collapsed"/>
                                    <TextBlock x:Name="CustomerOpenWireText" Visibility="Collapsed"/>
                                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <WrapPanel x:Name="CustomerCellPanel" Margin="5" ItemWidth="175"/>
                                    </ScrollViewer>

                                    <!-- Existing update targets retained as hidden raw sources. -->
                                    <TextBlock x:Name="CellExtremeText" Visibility="Collapsed"/>
                                    <TextBlock x:Name="CellsText" Visibility="Collapsed"/>
                                </Grid>
                            </GroupBox>

                            <!-- Center: basic information + temperatures -->
                            <Grid Grid.Row="0" Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="48*"/>
                                    <RowDefinition Height="52*"/>
                                </Grid.RowDefinitions>

                                <GroupBox Grid.Row="0" Header="基础信息" Style="{StaticResource CustomerGroupBox}">
                                    <Grid Margin="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64*"/>
                                            <ColumnDefinition Width="36*" MinWidth="76"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="57"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="总压" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="PackVoltageText" Grid.Row="0" Grid.Column="1" Style="{StaticResource CustomerValue}" Text="—"/>
                                            <TextBlock Grid.Row="1" Text="电流" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="CurrentText" Grid.Row="1" Grid.Column="1" Style="{StaticResource CustomerValue}" Text="—"/>
                                            <TextBlock Grid.Row="2" Text="SOH" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="CustomerSohText" Grid.Row="2" Grid.Column="1" Style="{StaticResource CustomerValue}" Text="—"/>
                                            <TextBlock Grid.Row="3" Text="剩余容量" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="CustomerRemainCapacityText" Grid.Row="3" Grid.Column="1" Style="{StaticResource CustomerValue}" Text="—"/>
                                            <TextBlock Grid.Row="4" Text="满电容量" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="CustomerFullCapacityText" Grid.Row="4" Grid.Column="1" Style="{StaticResource CustomerValue}" Text="—"/>
                                            <TextBlock Grid.Row="5" Text="循环次数" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="CustomerCycleText" Grid.Row="5" Grid.Column="1" Style="{StaticResource CustomerValue}" Text="—"/>
                                            <TextBlock Grid.Row="6" Text="工作状态" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="WorkStateText" Grid.Row="6" Grid.Column="1" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Text="—"/>
                                        </Grid>

                                        <Grid Grid.Column="1" Margin="2,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="42"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Viewbox StretchDirection="DownOnly" Margin="1">
                                                <TextBlock x:Name="CustomerSocText" FontSize="18" Text="SOC:—"/>
                                            </Viewbox>
                                            <Viewbox Grid.Row="1" StretchDirection="DownOnly" VerticalAlignment="Center">
                                                <Grid Width="78" Height="170">
                                                    <Border BorderBrush="#666" BorderThickness="5" CornerRadius="12" Background="#FAFAFA" Margin="5,9,5,0"/>
                                                    <Border Width="28" Height="10" Background="#666" CornerRadius="2" VerticalAlignment="Top"/>
                                                    <Grid Margin="11,22,11,9" ClipToBounds="True">
                                                        <Border x:Name="CustomerSocFill" Height="0" Background="#32B965" CornerRadius="3" VerticalAlignment="Bottom"/>
                                                    </Grid>
                                                </Grid>
                                            </Viewbox>
                                        </Grid>

                                        <TextBlock x:Name="SocText" Visibility="Collapsed"/>
                                        <TextBlock x:Name="CapacityText" Visibility="Collapsed"/>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Grid.Row="1" Header="温度(℃)" Style="{StaticResource CustomerGroupBox}">
                                    <Grid Margin="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="MonitorTemperatureLabel" Grid.Row="0" Text="最高温度" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CustomerMaxTempText" Grid.Row="0" Grid.Column="1" FontSize="16" Foreground="Red" FontWeight="Bold" VerticalAlignment="Center" Text="—"/>
                                        <TextBlock Grid.Row="1" Text="最低温度" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CustomerMinTempText" Grid.Row="1" Grid.Column="1" FontSize="16" Foreground="Green" FontWeight="Bold" VerticalAlignment="Center" Text="—"/>
                                        <TextBlock Grid.Row="2" Text="MOS温度" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CustomerMosTempText" Grid.Row="2" Grid.Column="1" FontSize="15" VerticalAlignment="Center" Text="—"/>
                                        <TextBlock Grid.Row="3" Text="数据更新时间" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LastUpdateText" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Text="未读取"/>
                                        <TextBlock x:Name="TempsText" Visibility="Collapsed"/>
                                    </Grid>
                                </GroupBox>
                            </Grid>

                            <!-- Right: communications, status and alarms -->
                            <Grid Grid.Row="0" Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <GroupBox Grid.Row="0" Header="通信设置" Style="{StaticResource CustomerGroupBox}">
                                    <StackPanel Margin="4">
                                        <DockPanel LastChildFill="False">
                                            <ComboBox x:Name="ConnectionModeBox" DockPanel.Dock="Left" Width="80" Height="30"
                                                      SelectedIndex="0" SelectionChanged="ConnectionModeBox_SelectionChanged"
                                                      AutomationProperties.Name="通信方式">
                                                <ComboBoxItem Content="蓝牙"/>
                                                <ComboBoxItem Content="串口"/>
                                                <ComboBoxItem Content="一线通"/>
                                                <ComboBoxItem Content="CAN" ToolTip="Comm Tool · 250 kbit/s · BMS 地址 0"/>
                                            </ComboBox>
                                            <Button x:Name="ConnectButton" DockPanel.Dock="Right" Style="{StaticResource CustomerButton}" Click="ConnectButton_Click">连接</Button>
                                            <Button x:Name="StopScanButton" DockPanel.Dock="Right" Style="{StaticResource CustomerButton}" Margin="0,0,6,0" Click="StopScanButton_Click">停止</Button>
                                            <Button x:Name="ScanButton" DockPanel.Dock="Right" Style="{StaticResource CustomerButton}" Margin="0,0,6,0" Click="ScanButton_Click">搜索</Button>
                                        </DockPanel>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="DeviceList" Grid.ColumnSpan="2" Height="30"
                                                      ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}">
                                                <ComboBox.GroupStyle>
                                                    <GroupStyle>
                                                        <GroupStyle.HeaderTemplate>
                                                            <DataTemplate><TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="DimGray" Margin="4,6,0,2"/></DataTemplate>
                                                        </GroupStyle.HeaderTemplate>
                                                    </GroupStyle>
                                                </ComboBox.GroupStyle>
                                            </ComboBox>
                                            <ComboBox x:Name="SerialPortList" Height="30" Visibility="Collapsed"
                                                      AutomationProperties.Name="COM 端口"/>
                                            <ComboBox x:Name="SerialBaudRateBox" Grid.Column="1" Width="96" Height="30" Margin="6,0,0,0"
                                                      IsEditable="True" Text="19200" Visibility="Collapsed" AutomationProperties.Name="波特率">
                                                <ComboBoxItem Content="9600"/>
                                                <ComboBoxItem Content="19200"/>
                                                <ComboBoxItem Content="38400"/>
                                                <ComboBoxItem Content="57600"/>
                                                <ComboBoxItem Content="115200"/>
                                            </ComboBox>
                                            <ComboBox x:Name="OwcModeBox" Grid.Column="1" Width="158" Height="30" Margin="6,0,0,0"
                                                      SelectedIndex="0" Visibility="Collapsed" AutomationProperties.Name="一线通协议">
                                                <ComboBoxItem Content="自动识别"/>
                                                <ComboBoxItem Content="A1.3.3"/>
                                                <ComboBoxItem Content="锂神（含本项目扩展）"/>
                                            </ComboBox>
                                        </Grid>
                                        <DockPanel Margin="0,4,0,0" LastChildFill="False">
                                            <Button x:Name="CancelConnectionButton" DockPanel.Dock="Right" Content="取消连接" Click="CancelConnection_Click"
                                                    IsEnabled="False" Padding="8,2" Visibility="Collapsed"/>
                                        </DockPanel>
                                        <WrapPanel HorizontalAlignment="Right" Margin="0,4,0,0">
                                            <Button x:Name="DisconnectButton" Style="{StaticResource CustomerButton}" Margin="0,2,6,2" Click="CustomerDisconnect_Click">断开</Button>
                                            <Button x:Name="MonitorSleepButton" Style="{StaticResource CustomerButton}" Margin="0,2,6,2" Click="SleepBms_Click">休眠</Button>
                                            <Button x:Name="FeidaoButton" Visibility="Collapsed" Margin="0,2,6,2" Padding="8,3" Click="OpenFeidao_Click">飞道广播</Button>
                                            <Button x:Name="MonitorRenameButton" Style="{StaticResource CustomerButton}" Margin="0,2,6,2" Click="OpenNamePage_Click">改名</Button>
                                            <Button x:Name="ProtectedFeaturesButton" Style="{StaticResource CustomerButton}" Margin="0,2,0,2" Click="OpenProtectedFeatures_Click">高级功能</Button>
                                        </WrapPanel>
                                        <TextBlock x:Name="BleDiscoveryStatusText" Text="尚未搜索附近设备" TextWrapping="Wrap" FontSize="11"/>
                                        <TextBlock x:Name="ConnectionText" TextWrapping="Wrap" FontSize="11"/>
                                        <TextBlock x:Name="OwcStatusText" TextWrapping="Wrap" FontSize="11" Visibility="Collapsed"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox x:Name="MonitorMosGroup" Grid.Row="1" Header="系统状态" Style="{StaticResource CustomerGroupBox}">
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                            <TextBlock Text="充电MOS" HorizontalAlignment="Center"/>
                                            <Border x:Name="CustomerChargeMosLamp" Width="62" Height="34" Margin="0,6,0,0" CornerRadius="5" Background="#B0B0B0"><TextBlock x:Name="CustomerChargeMosText" Text="--" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                            <TextBlock Text="放电MOS" HorizontalAlignment="Center"/>
                                            <Border x:Name="CustomerDischargeMosLamp" Width="62" Height="34" Margin="0,6,0,0" CornerRadius="5" Background="#B0B0B0"><TextBlock x:Name="CustomerDischargeMosText" Text="--" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        </StackPanel>
                                        <TextBlock x:Name="MosStateText" Visibility="Collapsed"/>
                                        <TextBlock x:Name="SystemStateText" Visibility="Collapsed"/>
                                    </Grid>
                                </GroupBox>

                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition x:Name="MonitorSecondaryAlarmRow" Height="*"/>
                                        <RowDefinition x:Name="MonitorTertiaryAlarmRow" Height="*"/>
                                        <RowDefinition Height="2.5*"/>
                                    </Grid.RowDefinitions>
                                    <GroupBox x:Name="MonitorPrimaryAlarm" Grid.Row="0" Header="一级告警" Style="{StaticResource CustomerGroupBox}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <TextBlock x:Name="CustomerAlarm1Text" Margin="2" FontSize="16" FontWeight="SemiBold" Text="—" TextWrapping="Wrap"/>
                                        </ScrollViewer>
                                    </GroupBox>
                                    <GroupBox x:Name="MonitorSecondaryAlarm" Grid.Row="1" Header="二级告警" Style="{StaticResource CustomerGroupBox}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <TextBlock x:Name="CustomerAlarm2Text" Margin="2" FontSize="16" FontWeight="SemiBold" Text="—" TextWrapping="Wrap"/>
                                        </ScrollViewer>
                                    </GroupBox>
                                    <GroupBox x:Name="MonitorTertiaryAlarm" Grid.Row="2" Header="三级保护" Style="{StaticResource CustomerGroupBox}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <TextBlock x:Name="CustomerAlarm3Text" Margin="2" FontSize="16" FontWeight="SemiBold" Text="—" TextWrapping="Wrap"/>
                                        </ScrollViewer>
                                    </GroupBox>
                                    <GroupBox Grid.Row="3" Header="系统监控信息" Style="{StaticResource CustomerGroupBox}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="5">
                                                <StackPanel x:Name="ModbusMonitorDetails">
                                                    <TextBlock x:Name="CustomerSystemMonitorText" Margin="0,0,0,5" TextWrapping="Wrap" Text="—"/>
                                                    <Separator Margin="0,0,0,5"/>
                                                    <TextBlock Text="实时休眠状态" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="SleepStatusText" Margin="0,5,0,0" Text="未连接，无法确认设备是否休眠" TextWrapping="Wrap"
                                                       ToolTip="随实时监控刷新。剩余时间由固件提供；时间到期后仍须通过门禁。断连不能证明设备已休眠。BLE连接和通信读取可能阻止休眠。"/>
                                                </StackPanel>
                                                <StackPanel x:Name="OwcMonitorDetails" Visibility="Collapsed">
                                                    <TextBlock x:Name="OwcProtocolText" Text="协议：—" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </GroupBox>
                                    <TextBlock x:Name="ProtectionLevelsText" Visibility="Collapsed"/>
                                </Grid>
                            </Grid>

                        </Grid>
                    </ScrollViewer>
                    <!-- Main-page status bar -->
                    <Border Grid.Row="2" BorderBrush="#C8C8C8" BorderThickness="1,1,1,0" Background="#F5F5F5" Margin="5,2,5,0" Padding="8,4">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CustomerHardwareText" Grid.Column="0" VerticalAlignment="Center" Text="硬件版本：—"/>
                            <TextBlock x:Name="CustomerSoftwareText" Grid.Column="1" VerticalAlignment="Center" Text="软件版本：—"/>
                            <TextBlock x:Name="CustomerSerialText" Grid.Column="2" VerticalAlignment="Center" Text="BMS序列号：—"/>
                            <Border x:Name="CustomerCommStatusBorder" Grid.Column="3" Background="#18C73E" Padding="9,2" Visibility="Collapsed">
                                <TextBlock x:Name="CommunicationStatusText" Text="通信：未连接" Foreground="Black"/>
                            </Border>
                            <TextBlock x:Name="CustomerBuildText" Grid.Row="1" Grid.ColumnSpan="4" Margin="0,4,0,0" TextWrapping="Wrap" Text="固件 Build ID：—"/>
                            <TextBlock x:Name="CustomerClockText" Grid.Row="2" Grid.ColumnSpan="4" Margin="0,4,0,0" TextWrapping="Wrap" Text="板载时间：—" ToolTip="板内使用UTC；此处按电脑本地时区显示，每5秒读取一次。未同步或误差超过5分钟时自动校时。"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="ProtectionTab" Header="软件保护 / BMS 参数" Visibility="Collapsed">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,8">
                            <Button Width="105" Click="ReadProtection_Click">读取全部</Button>
                            <Button Width="115" Margin="8,0,0,0" Click="WriteSelectedProtection_Click">写入选中项</Button>
                            <Button Width="135" Margin="8,0,0,0" Click="WriteChangedProtection_Click">写入全部修改项</Button>
                            <TextBlock x:Name="ProtectionStatusText" Margin="14,0,0,0" VerticalAlignment="Center" Text="未读取"/>
                        </StackPanel>
                    </StackPanel>

                    <DataGrid x:Name="ProtectionGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Single" SelectionUnit="FullRow" Margin="0,0,0,10" IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="保护项" Binding="{Binding Group}" Width="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="参数" Binding="{Binding Stage}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="当前值" Binding="{Binding DeviceDisplayValue}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="修改值" Binding="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                            <DataGridTextColumn Header="单位 / 说明" Binding="{Binding Hint}" Width="*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <GroupBox Grid.Row="2" Header="BMS 参数">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock FontWeight="SemiBold" Text="SOC 校准"/>
                                <TextBlock x:Name="CurrentSocParamText" Margin="0,5,0,8" Text="当前 SOC：—"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="SocSetBox" Width="100" Height="28" Text="60"/>
                                    <TextBlock VerticalAlignment="Center" Margin="6,0">%</TextBlock>
                                    <Button Width="115" Margin="10,0,0,0" Click="WriteSocParameter_Click">写入并校验</Button>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock FontWeight="SemiBold" Text="循环次数"/>
                                <TextBlock x:Name="CurrentCycleParamText" Margin="0,5,0,8" Text="当前循环次数：—"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="CycleSetBox" Width="100" Height="28" Text="0"/>
                                    <Button Width="115" Margin="10,0,0,0" Click="WriteCycleParameter_Click">写入并校验</Button>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="BmsParamResultText" Grid.ColumnSpan="2" Margin="0,46,0,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem x:Name="DeviceInfoTab" Header="设备信息 / 蓝牙名">
                <StackPanel Margin="16">
                    <Button Width="120" HorizontalAlignment="Left" Click="RefreshIdentity_Click">刷新设备信息</Button>
                    <TextBlock x:Name="IdentityText" Margin="0,14,0,20" FontSize="15" Text="—"/>
                    <TextBlock x:Name="DeviceClockText" Margin="0,0,0,20" FontSize="15" Text="板载时间：—" TextWrapping="Wrap"/>
                    <GroupBox Header="设备 SN" Margin="0,0,0,14">
                        <StackPanel Margin="12">
                            <WrapPanel Margin="0,10,0,0">
                                <TextBox x:Name="DeviceSerialBox" Width="300" Height="32" MaxLength="32" Margin="0,0,10,6"/>
                                <Button Padding="12,5" Margin="0,0,8,6" Click="ReadDeviceSerial_Click">读取参数 / SN</Button>
                                <Button Padding="12,5" Margin="0,0,0,6" Click="WriteDeviceSerial_Click">保存 SN 并确认</Button>
                            </WrapPanel>
                            <TextBlock x:Name="DeviceSerialStatusText" Text="尚未读取" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="修改蓝牙名">
                        <StackPanel Margin="12">
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock VerticalAlignment="Center" FontSize="16" Text="BT_"/>
                                <TextBox x:Name="NameSuffixBox" Width="240" Height="30" Margin="4,0,10,0"/>
                                <Button Width="110" Click="WriteName_Click">写入并确认</Button>
                                <TextBlock x:Name="BtNameResultText" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>


            <TabItem x:Name="OtaTab" Header="OTA 升级">
                <StackPanel Margin="16">
                    <StackPanel Orientation="Horizontal">
                        <Button Width="100" Click="BrowseFirmware_Click">选择升级包</Button>
                        <TextBlock x:Name="FirmwareText" Margin="12,0,0,0" VerticalAlignment="Center" Text="未选择升级包"/>
                    </StackPanel>
                    <WrapPanel Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center">OTA 架构</TextBlock>
                        <ComboBox x:Name="OtaTargetBox" Width="210" Margin="8,0">
                            <ComboBoxItem Content="Auto（自动识别）" Tag="Auto" IsSelected="True"/>
                            <ComboBoxItem Content="Telink BLE / UART / RS485" Tag="Telink"/>
                            <ComboBoxItem Content="BMS 串口透传（旧协议需确认）" Tag="Stm32SerialIap"/>
                        </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center">Telink 模式</TextBlock>
                        <ComboBox x:Name="OtaModeBox" Width="170" Margin="8,0,8,0">
                            <ComboBoxItem Content="Auto" Tag="Auto" IsSelected="True"/>
                            <ComboBoxItem Content="Legacy Fast (16B)" Tag="LegacyFast"/>
                            <ComboBoxItem Content="Extend 64B" Tag="Extend64"/>
                        </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0">目标软件版本（可选）</TextBlock>
                        <TextBox x:Name="ExpectedVersionBox" Width="180" Margin="8,0"/>
                        </StackPanel>
                    </WrapPanel>
                    <Expander Header="升级恢复" Margin="0,10,0,0">
                        <CheckBox x:Name="SerialIapRecoveryBox" Margin="16,6,0,0" Content="使用选中的串口或蓝牙设备恢复升级"/>
                    </Expander>
                    <ProgressBar x:Name="OtaProgressBar" Height="24" Margin="0,18,0,0" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="OtaProgressText" Margin="0,6,0,0" Text="待升级"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="StartOtaButton" Width="110" Click="StartOta_Click">开始升级</Button>
                        <Button x:Name="CancelOtaButton" Width="90" Margin="10,0,0,0" IsEnabled="False" Click="CancelOta_Click">取消</Button>
                    </StackPanel>
                    <TextBlock x:Name="OtaVerifyText" Margin="0,18,0,0" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
