<Window x:Class="BmsTool.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BMS Assistant" Height="900" Width="1360" MinHeight="760" MinWidth="1180"
        Background="#F3F3F3" Loaded="CustomerUi_Loaded">
    <Window.Resources>
        <Style x:Key="CustomerGroupBox" TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#C8C8C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="CustomerValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CustomerButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Padding" Value="10,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <TabControl x:Name="MainTabs">
            <TabItem Header="实时监控">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35*"/>
                        <ColumnDefinition Width="27*"/>
                        <ColumnDefinition Width="38*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: cell voltages -->
                    <GroupBox Grid.Row="0" Grid.Column="0" Header="单体电压(mV)" Style="{StaticResource CustomerGroupBox}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="76"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="4,0,4,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="最高电压" Width="76" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CustomerMaxCellText" Foreground="Red" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Text="—"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="最低电压" Width="76" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CustomerMinCellText" Foreground="Green" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Text="—"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="平均电压" Width="76" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CustomerAvgCellText" VerticalAlignment="Center" Text="—"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="最大压差" Width="76" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CustomerDeltaCellText" VerticalAlignment="Center" Text="—"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="有效串数" Width="76" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CustomerCellCountText" VerticalAlignment="Center" Text="—"/>
                                </StackPanel>
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <WrapPanel x:Name="CustomerCellPanel" Margin="5" ItemWidth="205"/>
                            </ScrollViewer>

                            <!-- Existing update targets retained as hidden raw sources. -->
                            <TextBlock x:Name="CellExtremeText" Visibility="Collapsed"/>
                            <TextBlock x:Name="CellsText" Visibility="Collapsed"/>
                        </Grid>
                    </GroupBox>

                    <!-- Center: basic information + temperatures -->
                    <Grid Grid.Row="0" Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48*"/>
                            <RowDefinition Height="52*"/>
                        </Grid.RowDefinitions>

                        <GroupBox Grid.Row="0" Header="基础信息" Style="{StaticResource CustomerGroupBox}">
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58*"/>
                                    <ColumnDefinition Width="42*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="总压" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PackVoltageText" Grid.Row="0" Grid.Column="1" Style="{StaticResource CustomerValue}" Text="—"/>
                                    <TextBlock Grid.Row="1" Text="电流" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CurrentText" Grid.Row="1" Grid.Column="1" Style="{StaticResource CustomerValue}" Text="—"/>
                                    <TextBlock Grid.Row="2" Text="SOH" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CustomerSohText" Grid.Row="2" Grid.Column="1" Style="{StaticResource CustomerValue}" Text="—"/>
                                    <TextBlock Grid.Row="3" Text="剩余容量" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CustomerRemainCapacityText" Grid.Row="3" Grid.Column="1" Style="{StaticResource CustomerValue}" Text="—"/>
                                    <TextBlock Grid.Row="4" Text="满电容量" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CustomerFullCapacityText" Grid.Row="4" Grid.Column="1" Style="{StaticResource CustomerValue}" Text="—"/>
                                    <TextBlock Grid.Row="5" Text="循环次数" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CustomerCycleText" Grid.Row="5" Grid.Column="1" Style="{StaticResource CustomerValue}" Text="—"/>
                                    <TextBlock Grid.Row="6" Text="工作状态" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="WorkStateText" Grid.Row="6" Grid.Column="1" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Text="—"/>
                                </Grid>

                                <Grid Grid.Column="1" HorizontalAlignment="Center" Margin="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="42"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="CustomerSocText" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Text="SOC:—"/>
                                    <Grid Grid.Row="1" Width="78" Height="170" VerticalAlignment="Center">
                                        <Border BorderBrush="#666" BorderThickness="5" CornerRadius="12" Background="#FAFAFA" Margin="5,9,5,0"/>
                                        <Border Width="28" Height="10" Background="#666" CornerRadius="2" VerticalAlignment="Top"/>
                                        <Grid Margin="11,22,11,9" ClipToBounds="True">
                                            <Border x:Name="CustomerSocFill" Height="0" Background="#32B965" CornerRadius="3" VerticalAlignment="Bottom"/>
                                        </Grid>
                                    </Grid>
                                </Grid>

                                <TextBlock x:Name="SocText" Visibility="Collapsed"/>
                                <TextBlock x:Name="CapacityText" Visibility="Collapsed"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="1" Header="温度(℃)" Style="{StaticResource CustomerGroupBox}">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="最高温度" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CustomerMaxTempText" Grid.Row="0" Grid.Column="1" FontSize="16" Foreground="Red" FontWeight="Bold" VerticalAlignment="Center" Text="—"/>
                                <TextBlock Grid.Row="1" Text="最低温度" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CustomerMinTempText" Grid.Row="1" Grid.Column="1" FontSize="16" Foreground="Green" FontWeight="Bold" VerticalAlignment="Center" Text="—"/>
                                <TextBlock Grid.Row="2" Text="MOS温度" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CustomerMosTempText" Grid.Row="2" Grid.Column="1" FontSize="15" VerticalAlignment="Center" Text="—"/>
                                <TextBlock Grid.Row="3" Text="数据更新时间" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LastUpdateText" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Text="未读取"/>
                                <TextBlock x:Name="TempsText" Visibility="Collapsed"/>
                            </Grid>
                        </GroupBox>
                    </Grid>

                    <!-- Right: communications, status and alarms -->
                    <Grid Grid.Row="0" Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="148"/>
                            <RowDefinition Height="132"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <GroupBox Grid.Row="0" Header="通信设置" Style="{StaticResource CustomerGroupBox}">
                            <Grid Margin="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="44"/>
                                    <RowDefinition Height="44"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="DeviceList" Grid.Row="0" Grid.Column="0" Height="30" Margin="0,4,8,4"/>
                                <Button x:Name="ScanButton" Grid.Row="0" Grid.Column="1" Style="{StaticResource CustomerButton}" Margin="0,4,6,4" Click="ScanButton_Click">搜索</Button>
                                <Button x:Name="StopScanButton" Grid.Row="0" Grid.Column="2" Style="{StaticResource CustomerButton}" Margin="0,4,6,4" Click="StopScanButton_Click">停止</Button>
                                <Button x:Name="ConnectButton" Grid.Row="0" Grid.Column="3" Style="{StaticResource CustomerButton}" Margin="0,4,0,4" Click="ConnectButton_Click">连接</Button>

                                <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource CustomerButton}" Margin="0,4,6,4" Click="CustomerDisconnect_Click">断开</Button>
                                    <Button Style="{StaticResource CustomerButton}" Margin="0,4,6,4" Click="OpenNamePage_Click">改名</Button>
                                    <Button x:Name="ProtectedFeaturesButton" Style="{StaticResource CustomerButton}" Margin="0,4,0,4" Click="OpenProtectedFeatures_Click">高级功能</Button>
                                </StackPanel>
                                <TextBlock x:Name="ConnectionText" Visibility="Collapsed"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="1" Header="系统状态" Style="{StaticResource CustomerGroupBox}">
                            <Grid Margin="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="充电MOS" HorizontalAlignment="Center"/>
                                    <Border x:Name="CustomerChargeMosLamp" Width="62" Height="34" Margin="0,6,0,0" CornerRadius="5" Background="#B0B0B0"><TextBlock x:Name="CustomerChargeMosText" Text="--" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="放电MOS" HorizontalAlignment="Center"/>
                                    <Border x:Name="CustomerDischargeMosLamp" Width="62" Height="34" Margin="0,6,0,0" CornerRadius="5" Background="#B0B0B0"><TextBlock x:Name="CustomerDischargeMosText" Text="--" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="加热" HorizontalAlignment="Center"/>
                                    <Border x:Name="CustomerHeatLamp" Width="62" Height="34" Margin="0,6,0,0" CornerRadius="5" Background="#B0B0B0"><TextBlock x:Name="CustomerHeatText" Text="--" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                </StackPanel>
                                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                    <TextBlock Text="制冷" HorizontalAlignment="Center"/>
                                    <Border x:Name="CustomerCoolLamp" Width="62" Height="34" Margin="0,6,0,0" CornerRadius="5" Background="#B0B0B0"><TextBlock x:Name="CustomerCoolText" Text="--" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                </StackPanel>
                                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                    <TextBlock Text="均衡" HorizontalAlignment="Center"/>
                                    <Border x:Name="CustomerBalanceLamp" Width="62" Height="34" Margin="0,6,0,0" CornerRadius="5" Background="#B0B0B0"><TextBlock x:Name="CustomerBalanceText" Text="--" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                </StackPanel>
                                <TextBlock x:Name="MosStateText" Visibility="Collapsed"/>
                                <TextBlock x:Name="SystemStateText" Visibility="Collapsed"/>
                            </Grid>
                        </GroupBox>

                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <GroupBox Grid.Row="0" Header="一级告警" Style="{StaticResource CustomerGroupBox}">
                                <TextBlock x:Name="CustomerAlarm1Text" Margin="5" FontSize="16" FontWeight="SemiBold" Text="无" TextWrapping="Wrap"/>
                            </GroupBox>
                            <GroupBox Grid.Row="1" Header="二级告警" Style="{StaticResource CustomerGroupBox}">
                                <TextBlock x:Name="CustomerAlarm2Text" Margin="5" FontSize="16" FontWeight="SemiBold" Text="无" TextWrapping="Wrap"/>
                            </GroupBox>
                            <GroupBox Grid.Row="2" Header="三级保护" Style="{StaticResource CustomerGroupBox}">
                                <TextBlock x:Name="CustomerAlarm3Text" Margin="5" FontSize="16" FontWeight="SemiBold" Text="无" TextWrapping="Wrap"/>
                            </GroupBox>
                            <GroupBox Grid.Row="3" Header="系统监控信息" Style="{StaticResource CustomerGroupBox}">
                                <StackPanel Margin="5">
                                    <TextBlock x:Name="ProtectionSummaryText" FontWeight="Bold" Text="—"/>
                                    <TextBlock x:Name="CustomerSystemMonitorText" Margin="0,5,0,0" Text="—" TextWrapping="Wrap"/>
                                </StackPanel>
                            </GroupBox>
                            <TextBlock x:Name="ProtectionLevelsText" Visibility="Collapsed"/>
                        </Grid>
                    </Grid>

                    <!-- Main-page status bar -->
                    <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#C8C8C8" BorderThickness="1,1,1,0" Background="#F5F5F5" Margin="5,2,5,0" Padding="8,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CustomerHardwareText" Grid.Column="0" VerticalAlignment="Center" Text="硬件版本：—"/>
                            <TextBlock x:Name="CustomerSoftwareText" Grid.Column="1" VerticalAlignment="Center" Text="软件版本：—"/>
                            <TextBlock x:Name="CustomerSerialText" Grid.Column="2" VerticalAlignment="Center" Text="BMS序列号：—"/>
                            <Border x:Name="CustomerCommStatusBorder" Grid.Column="3" Background="#18C73E" Padding="9,2" Visibility="Collapsed">
                                <TextBlock Text="通信：正在通讯" Foreground="Black"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="ProtectionTab" Header="软件保护 / BMS 参数" Visibility="Collapsed">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="保护参数修改后会立即写入设备并保存。请确认参数符合当前电池规格。" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,8">
                            <Button Width="105" Click="ReadProtection_Click">读取全部</Button>
                            <Button Width="115" Margin="8,0,0,0" Click="WriteSelectedProtection_Click">写入选中项</Button>
                            <Button Width="135" Margin="8,0,0,0" Click="WriteChangedProtection_Click">写入全部修改项</Button>
                            <TextBlock x:Name="ProtectionStatusText" Margin="14,0,0,0" VerticalAlignment="Center" Text="未读取"/>
                        </StackPanel>
                    </StackPanel>

                    <DataGrid x:Name="ProtectionGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Single" SelectionUnit="FullRow" Margin="0,0,0,10" IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="保护项" Binding="{Binding Group}" Width="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="参数" Binding="{Binding Stage}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="当前值" Binding="{Binding DeviceDisplayValue}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="修改值" Binding="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                            <DataGridTextColumn Header="单位 / 说明" Binding="{Binding Hint}" Width="*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <GroupBox Grid.Row="2" Header="BMS 参数">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock FontWeight="SemiBold" Text="SOC 校准"/>
                                <TextBlock x:Name="CurrentSocParamText" Margin="0,5,0,8" Text="当前 SOC：—"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="SocSetBox" Width="100" Height="28" Text="60"/>
                                    <TextBlock VerticalAlignment="Center" Margin="6,0">%</TextBlock>
                                    <Button Width="115" Margin="10,0,0,0" Click="WriteSocParameter_Click">写入并校验</Button>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock FontWeight="SemiBold" Text="循环次数"/>
                                <TextBlock x:Name="CurrentCycleParamText" Margin="0,5,0,8" Text="当前循环次数：—"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="CycleSetBox" Width="100" Height="28" Text="0"/>
                                    <Button Width="115" Margin="10,0,0,0" Click="WriteCycleParameter_Click">写入并校验</Button>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="BmsParamResultText" Grid.ColumnSpan="2" Margin="0,46,0,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem x:Name="DeviceInfoTab" Header="设备信息 / 蓝牙名">
                <StackPanel Margin="16">
                    <Button Width="120" HorizontalAlignment="Left" Click="RefreshIdentity_Click">刷新设备信息</Button>
                    <TextBlock x:Name="IdentityText" Margin="0,14,0,20" FontSize="15" Text="—"/>
                    <GroupBox Header="修改蓝牙名">
                        <StackPanel Margin="12">
                            <TextBlock Text="设备名称固定以 BT_ 开头。此处只填写后缀，支持字母、数字、下划线和短横线。" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock VerticalAlignment="Center" FontSize="16" Text="BT_"/>
                                <TextBox x:Name="NameSuffixBox" Width="240" Height="30" Margin="4,0,10,0"/>
                                <Button Width="110" Click="WriteName_Click">写入并确认</Button>
                                <TextBlock x:Name="BtNameResultText" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <TabItem x:Name="OtaTab" Header="OTA 升级" Visibility="Collapsed">
                <StackPanel Margin="16">
                    <StackPanel Orientation="Horizontal">
                        <Button Width="100" Click="BrowseFirmware_Click">选择 BIN</Button>
                        <TextBlock x:Name="FirmwareText" Margin="12,0,0,0" VerticalAlignment="Center" Text="未选择固件"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock VerticalAlignment="Center">传输模式</TextBlock>
                        <ComboBox x:Name="OtaModeBox" Width="170" Margin="8,0">
                            <ComboBoxItem Content="Auto" Tag="Auto" IsSelected="True"/>
                            <ComboBoxItem Content="Legacy Fast (16B)" Tag="LegacyFast"/>
                            <ComboBoxItem Content="Extend 64B" Tag="Extend64"/>
                        </ComboBox>
                        <TextBlock VerticalAlignment="Center" Margin="20,0,0,0">目标软件版本（可选）</TextBlock>
                        <TextBox x:Name="ExpectedVersionBox" Width="180" Margin="8,0"/>
                    </StackPanel>
                    <TextBlock Margin="0,10,0,0" Text="升级完成后会自动等待设备重启、重新连接并读取电池数据，确认新程序已经正常运行。填写目标版本时还会进行版本一致性校验。" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="OtaProgressBar" Height="24" Margin="0,18,0,0" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="OtaProgressText" Margin="0,6,0,0" Text="Idle"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="StartOtaButton" Width="110" Click="StartOta_Click">开始 OTA</Button>
                        <Button x:Name="CancelOtaButton" Width="90" Margin="10,0,0,0" IsEnabled="False" Click="CancelOta_Click">取消</Button>
                    </StackPanel>
                    <TextBlock x:Name="OtaVerifyText" Margin="0,18,0,0" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
