<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BmsAppEdition Condition="'$(BmsAppEdition)' == ''">Internal</BmsAppEdition>
    <ApplicationVersion>19</ApplicationVersion>
    <ApplicationDisplayVersion>0.9.4</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <AndroidUseLatestPlatformSdk>true</AndroidUseLatestPlatformSdk>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**;publish/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BmsAppEdition)' == 'Internal'">
    <ApplicationId>com.cs.bmstool.android</ApplicationId>
    <ApplicationTitle>BMS Tool 测试版</ApplicationTitle>
    <DefineConstants>$(DefineConstants);BMS_INTERNAL_APP</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BmsAppEdition)' == 'Customer'">
    <ApplicationId>com.cs.bmsbattery</ApplicationId>
    <ApplicationTitle>BMS Battery</ApplicationTitle>
  </PropertyGroup>

  <Target Name="ValidateBmsAppEdition" BeforeTargets="PrepareForBuild"
          Condition="'$(BmsAppEdition)' != 'Internal' and '$(BmsAppEdition)' != 'Customer'">
    <Error Text="BmsAppEdition 只能是 Internal 或 Customer。" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\BmsTool.Core\BmsTool.Core.csproj" />
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
  </ItemGroup>
</Project>
