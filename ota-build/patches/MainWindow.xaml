<Window x:Class="Bms.Ota.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BMS Telink OTA" Height="760" Width="980" MinHeight="680" MinWidth="900">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="170"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Header="OTA 参数" Grid.Row="0" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Telink OTA GATT"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Margin="6,3" VerticalAlignment="Center"
                           Text="自动发现（官方 OTA UUID，无需填写 Handle/UUID）"/>
                <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Text="Max image bytes"/>
                <TextBox x:Name="MaxImageBytesBox" Grid.Row="0" Grid.Column="3" Margin="6,3" Text="0" ToolTip="0 表示不加产品层大小限制"/>

                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="发现策略"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="6,3" VerticalAlignment="Center"
                           Text="优先官方 Service；失败后全服务搜索 OTA Characteristic"/>
                <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="Packet delay (ms)"/>
                <TextBox x:Name="PacketDelayBox" Grid.Row="1" Grid.Column="3" Margin="6,3" Text="15"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="BLE 设备" Grid.Row="1" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                <ListBox x:Name="DeviceList" Grid.Column="0"/>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <Button x:Name="ScanButton" Content="扫描" Height="34" Margin="0,0,0,8" Click="ScanButton_Click"/>
                    <Button x:Name="StopScanButton" Content="停止扫描" Height="34" Margin="0,0,0,8" Click="StopScanButton_Click"/>
                    <Button x:Name="ConnectButton" Content="连接 OTA" Height="34" Click="ConnectButton_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Header="固件" Grid.Row="2" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="FirmwarePathText" Text="未选择 BIN" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="FirmwareInfoText" Margin="0,5,0,0" Text=""/>
                </StackPanel>
                <Button Grid.Column="1" Content="选择 BIN..." Height="34" Margin="10,0,0,0" Click="BrowseButton_Click"/>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <ProgressBar x:Name="OtaProgressBar" Height="22" Minimum="0" Maximum="100"/>
                <TextBlock x:Name="ProgressText" Margin="0,5,0,0" Text="Idle"/>
            </StackPanel>
            <Button x:Name="StartButton" Grid.Column="1" Content="开始 OTA" Height="38" Margin="10,0,0,0" Click="StartButton_Click"/>
            <Button x:Name="CancelButton" Grid.Column="2" Content="取消" Height="38" Margin="10,0,0,0" IsEnabled="False" Click="CancelButton_Click"/>
        </Grid>

        <TextBlock Grid.Row="4" Text="日志" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <TextBox x:Name="LogBox" Grid.Row="5" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" TextWrapping="NoWrap"/>
    </Grid>
</Window>
