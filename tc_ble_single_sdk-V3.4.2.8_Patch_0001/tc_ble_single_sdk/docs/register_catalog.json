          "description_zh": "当前容量。"
        },
        {
          "id": "capacity_full_raw",
          "index": 55,
          "address": "0xD037",
          "unit": "0.01Ah",
          "description_zh": "满充容量。"
        },
        {
          "id": "capacity_factory_raw",
          "index": 56,
          "address": "0xD038",
          "unit": "0.01Ah",
          "description_zh": "出厂容量。"
        },
        {
          "id": "cycle_count_raw",
          "index": 57,
          "address": "0xD039",
          "unit": "count",
          "description_zh": "循环次数。"
        },
        {
          "id": "unknown_tail_words",
          "start_index": 58,
          "word_count": 5,
          "start_address": "0xD03A",
          "end_address": "0xD03E",
          "unit": "raw",
          "description_zh": "当前客户端未解码的尾部保留区。"
        }
      ]
    },
    {
