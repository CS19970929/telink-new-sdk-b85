#!/bin/sh

APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit
JAVA_EXE="${JAVA_HOME:+$JAVA_HOME/bin/}java"

if ! command -v "$JAVA_EXE" >/dev/null 2>&1; then
  echo "ERROR: JAVA_HOME is not set correctly and java was not found." >&2
  echo "Please install JDK 17 and set JAVA_HOME." >&2
  exit 1
fi

CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
exec "$JAVA_EXE" "-Xmx64m" "-Xms64m" $JAVA_OPTS $GRADLE_OPTS \
  -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
