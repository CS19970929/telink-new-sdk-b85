.page{padding:24rpx;background:#f4f6f8;min-height:100vh;box-sizing:border-box}.header{margin:8rpx 0 24rpx}.title{display:block;font-size:42rpx;font-weight:700;color:#17202a}.subtitle{display:block;margin-top:8rpx;font-size:24rpx;color:#667085}.card{background:#fff;border-radius:20rpx;padding:24rpx;margin-bottom:20rpx;box-shadow:0 4rpx 18rpx rgba(16,24,40,.05)}.section-title{font-size:30rpx;font-weight:650;margin-bottom:18rpx;color:#1d2939}.status-row{display:flex;flex-direction:column;gap:6rpx;margin-bottom:16rpx}.status{font-weight:600;color:#175cd3}.note{font-size:24rpx;color:#667085}.button-row{display:flex;gap:12rpx}.button-row button{margin:0}.connected,.firmware-detail{margin-top:14rpx;color:#475467;font-size:24rpx}.device-list{height:320rpx}.device{display:flex;justify-content:space-between;align-items:center;padding:18rpx;border-radius:14rpx;margin-bottom:10rpx;background:#f8fafc;border:2rpx solid transparent}.device.selected{background:#eff8ff;border-color:#84caff}.device-name{font-weight:600;color:#1d2939}.device-id{margin-top:5rpx;font-size:20rpx;color:#98a2b3;max-width:500rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.rssi{font-size:22rpx;color:#667085}.empty{padding:30rpx 0;color:#98a2b3;text-align:center}.firmware-name{margin-top:16rpx;font-weight:600;word-break:break-all}.progress-text{text-align:right;margin-top:8rpx;font-size:24rpx;color:#475467}.ota-button{margin-top:20rpx}.warning{margin-top:18rpx;padding:16rpx;border-radius:12rpx;background:#fffaeb;color:#b54708;font-size:23rpx;line-height:1.55}.log-list{height:280rpx;background:#101828;border-radius:12rpx;padding:14rpx;box-sizing:border-box}.log-line{color:#d0d5dd;font-family:monospace;font-size:20rpx;line-height:1.5;word-break:break-all}