<view class="page">
  <view class="hero"><view class="title">BMS Assistant</view><view class="subtitle">BLE / Modbus RTU V1</view><view class="status">{{status}} · {{note}}</view></view>
  <view class="card"><view class="section-title">设备</view><view class="actions"><button size="mini" type="primary" bindtap="startScan">扫描</button><button size="mini" bindtap="disconnect">断开</button></view><view wx:if="{{connectedName}}" class="connected">已连接：{{connectedName}}</view><block wx:for="{{devices}}" wx:key="deviceId"><view class="device-row"><view><view class="device-name">{{item.localName || item.name || item.deviceId}}</view><view class="muted">RSSI {{item.rssi}} · {{item.deviceId}}</view></view><button size="mini" data-device-id="{{item.deviceId}}" bindtap="connectDevice">连接</button></view></block></view>
  <view class="card" wx:if="{{battery}}"><view class="section-title">电池状态</view><view class="grid"><view class="metric"><text class="label">总压</text><text class="value">{{battery.packVoltage}} V</text></view><view class="metric"><text class="label">电流</text><text class="value">{{battery.signedCurrent}} A</text></view><view class="metric"><text class="label">SOC</text><text class="value">{{battery.soc}} %</text></view><view class="metric"><text class="label">SOH</text><text class="value">{{battery.soh}} %</text></view><view class="metric"><text class="label">最高温</text><text class="value">{{battery.maxTemp}} °C</text></view><view class="metric"><text class="label">MOS 温度</text><text class="value">{{battery.mosTemp}} °C</text></view><view class="metric"><text class="label">最高单体</text><text class="value">{{battery.maxCellVoltage}} mV</text></view><view class="metric"><text class="label">压差</text><text class="value">{{battery.cellDelta}} mV</text></view></view><view class="muted">数据源：{{battery.source}} · 协议 {{battery.protocolVersion}}</view><view class="cell-list"><text wx:for="{{battery.cellVoltages}}" wx:key="index" class="cell">C{{index + 1}} {{item}}mV</text></view><view class="actions"><button size="mini" type="primary" loading="{{busy}}" bindtap="refreshStatus">刷新状态</button><button size="mini" loading="{{busy}}" bindtap="echoTest">Echo</button></view></view>
  <view class="card" wx:if="{{identity}}"><view class="section-title">设备信息</view><view class="kv">MAC：{{identity.macAddress}}</view><view class="kv">SN：{{identity.serialNumber}}</view><view class="kv">HW：{{identity.hardwareVersion}}</view><view class="kv">SW：{{identity.softwareVersion}}</view><button size="mini" bindtap="refreshIdentity">刷新设备信息</button></view>
  <view class="card" wx:if="{{status === 'ready'}}"><view class="section-title">工程写操作</view><view class="form-row"><input value="{{socInput}}" bindinput="onSocInput" type="number" placeholder="SOC 0~100"/><button size="mini" loading="{{busy}}" bindtap="writeSoc">写 SOC</button></view><view class="form-row"><input value="{{nameSuffixInput}}" bindinput="onNameSuffixInput" maxlength="10" placeholder="蓝牙名后缀"/><button size="mini" loading="{{busy}}" bindtap="writeNameSuffix">写名称</button></view><view class="warning">当前固件 BLE SMP 未启用，正式客户版不得默认开放危险写操作。</view></view>
  <view class="card"><view class="section-title">通信日志</view><view wx:for="{{logs}}" wx:key="index" class="log-line">{{item}}</view></view>
</view>
