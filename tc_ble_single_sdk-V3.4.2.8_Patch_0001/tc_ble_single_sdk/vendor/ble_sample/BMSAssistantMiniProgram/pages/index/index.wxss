.page{padding:24rpx;background:#f4f6f8;min-height:100vh;box-sizing:border-box;color:#17212b}.hero{padding:30rpx 8rpx 20rpx}.title{font-size:44rpx;font-weight:700}.subtitle,.status,.muted{color:#6b7280;font-size:24rpx}.status{margin-top:10rpx}.card{background:#fff;border-radius:20rpx;padding:24rpx;margin-bottom:20rpx;box-shadow:0 6rpx 20rpx rgba(0,0,0,.04)}.section-title{font-weight:700;font-size:30rpx;margin-bottom:18rpx}.actions{display:flex;gap:16rpx;margin-top:18rpx}.device-row,.form-row{display:flex;justify-content:space-between;align-items:center;gap:16rpx;padding:14rpx 0;border-bottom:1rpx solid #edf0f2}.device-name{font-weight:600}.connected{margin-top:12rpx;padding:12rpx;background:#eefbf2;border-radius:12rpx}.grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.metric{background:#f7f8fa;padding:16rpx;border-radius:14rpx;display:flex;flex-direction:column}.label{font-size:22rpx;color:#6b7280}.value{font-size:30rpx;font-weight:700;margin-top:4rpx}.cell-list{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:16rpx}.cell{padding:8rpx 12rpx;background:#f7f8fa;border-radius:10rpx;font-size:22rpx}.kv{margin:8rpx 0;font-size:26rpx;word-break:break-all}input{flex:1;background:#f7f8fa;border-radius:12rpx;padding:14rpx}.warning{margin-top:16rpx;color:#a24a00;background:#fff7ed;border-radius:12rpx;padding:14rpx;font-size:22rpx}.log-line{font-family:monospace;font-size:20rpx;padding:8rpx 0;border-bottom:1rpx solid #f0f0f0;word-break:break-all}
