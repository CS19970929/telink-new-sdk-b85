#!/bin/sh

# Warn about unfinished checklist items before push. This hook must never block
# a push; it only prints reminders and exits successfully.

repo_root=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$repo_root" ]; then
	exit 0
fi

git_cmd=$(command -v git 2>/dev/null)
case "$git_cmd" in
	*.codex-pending/*|*.codex-pending\\*)
		exit 0
		;;
esac

found=0

for pending_file in "$repo_root/TODO.md" "$repo_root/TEST_PENDING.md"; do
	if [ ! -f "$pending_file" ]; then
		continue
	fi

	matches=$(grep -E '^- \[ \]' "$pending_file" 2>/dev/null)
	if [ -z "$matches" ]; then
		continue
	fi

	if [ "$found" -eq 0 ]; then
		printf '\n'
		printf '%s\n' '========================================'
		printf '%s\n' 'WARNING: unfinished items found'
		printf '%s\n' 'Please review the following list before push:'
	fi

	printf '%s\n' "File: $pending_file"
	printf '%s\n' "$matches"
	found=1
done

if [ "$found" -ne 0 ]; then
	printf '%s\n' '========================================'
	printf '\n'
fi

exit 0
