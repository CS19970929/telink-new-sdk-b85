#!C:/Windows/System32/WindowsPowerShell/v1.0/powershell.exe -NoProfile -ExecutionPolicy Bypass -File
param()

$ErrorActionPreference = 'Stop'

$repoRoot = (git rev-parse --show-toplevel 2>$null).Trim()
if (-not $repoRoot) { exit 0 }

$pendingFiles = @(
    (Join-Path $repoRoot 'TODO.md')
    (Join-Path $repoRoot 'TEST_PENDING.md')
)

$found = $false

foreach ($pendingFile in $pendingFiles) {
    if (-not (Test-Path -LiteralPath $pendingFile)) {
        continue
    }

    $matches = Select-String -LiteralPath $pendingFile -Pattern '^- \[ \]' -SimpleMatch:$false
    if ($matches) {
        if (-not $found) {
            Write-Host ''
            Write-Host '========================================'
            Write-Host 'WARNING: unfinished items found'
            Write-Host 'Please review the following list before push:'
        }

        Write-Host "File: $pendingFile"
        $matches | ForEach-Object { Write-Host $_.Line }
        $found = $true
    }
}

if ($found) {
    Write-Host '========================================'
    Write-Host ''
}

exit 0
