<?xml version="1.0"?>
<!--
  Cppcheck data model for Telink tc32-elf-gcc 4.5.1-tc32-1.3.
  Values were extracted from the pinned compiler with:
    tc32-elf-gcc -dM -E -x c -
  This models type widths only; it does not claim that TC32 is ARM/Unix.
-->
<platform>
  <char_bit>8</char_bit>
  <default-sign>signed</default-sign>
  <sizeof>
    <bool>1</bool>
    <short>2</short>
    <int>4</int>
    <long>4</long>
    <long-long>8</long-long>
    <float>4</float>
    <double>8</double>
    <long-double>8</long-double>
    <pointer>4</pointer>
    <size_t>4</size_t>
    <wchar_t>4</wchar_t>
  </sizeof>
</platform>
