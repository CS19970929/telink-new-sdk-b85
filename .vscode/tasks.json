{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "D008 固件配置",
      "type": "process",
      "command": "python",
      "args": [
        "-X",
        "utf8",
        "-B",
        "d008/configure.py",
        "--editor",
        "${execPath}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "focus": false,
        "panel": "dedicated"
      }
    },
    {
      "label": "D008 主机回归",
      "type": "process",
      "command": "python",
      "args": [
        "-X",
        "utf8",
        "-B",
        "d008/tests/run.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
