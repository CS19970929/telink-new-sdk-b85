{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "d008Profile",
      "type": "pickString",
      "description": "D008 装配",
      "options": [
        "16s-lfp",
        "20s-nmc",
        "23s-lfp",
        "24s-lfp"
      ],
      "default": "16s-lfp"
    },
    {
      "id": "d008Sif",
      "type": "pickString",
      "description": "一线通协议",
      "options": [
        "lishen",
        "lishen-extended",
        "a133"
      ],
      "default": "lishen"
    }
  ],
  "tasks": [
    {
      "label": "D008 独立固件链接（无镜像）",
      "type": "process",
      "command": "python",
      "args": [
        "-X",
        "utf8",
        "-B",
        "d008/build.py",
        "--profile",
        "${input:d008Profile}",
        "--sif",
        "${input:d008Sif}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "D008 主机回归",
      "type": "process",
      "command": "python",
      "args": [
        "-X",
        "utf8",
        "-B",
        "d008/tests/run.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
