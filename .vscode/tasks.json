{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "d008Profile",
      "type": "pickString",
      "description": "D008 装配",
      "options": [
        "16s-lfp",
        "20s-nmc",
        "23s-lfp",
        "24s-lfp",
        "custom"
      ],
      "default": "16s-lfp"
    }
  ],
  "tasks": [
    {
      "label": "D008 源码配置",
      "type": "process",
      "command": "python",
      "args": [
        "-X",
        "utf8",
        "-B",
        "bms_tools/build_options.py",
        "show"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "D008 生产链接（无镜像）",
      "type": "process",
      "command": "python",
      "args": [
        "-X",
        "utf8",
        "-B",
        "bms_tools/bms.py",
        "--production",
        "--d008-profile",
        "${input:d008Profile}",
        "link",
        "--jobs",
        "4"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
