{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "BMS: 选择配置编译并发送 OTA",
      "detail": "单项目配置：装配、模式、电池类型、容量和 OTA 参数生效；可仅生成 BIN",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/bms_tools/select_firmware_build.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {"PYTHONDONTWRITEBYTECODE": "1", "PYTHONUTF8": "1"}
      },
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": [],
      "presentation": {"reveal": "always", "focus": false, "panel": "dedicated", "clear": true},
      "runOptions": {"instanceLimit": 1}
    },
    {
      "label": "BMS: compile",
      "type": "process",
      "command": "python",
      "args": [
        "bms_tools/bms.py",
        "--product",
        "${input:product}",
        "compile",
        "--jobs",
        "4"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONDONTWRITEBYTECODE": "1",
          "PYTHONUTF8": "1"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "BMS: link",
      "type": "process",
      "command": "python",
      "args": [
        "bms_tools/bms.py",
        "--product",
        "${input:product}",
        "link",
        "--jobs",
        "4"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONDONTWRITEBYTECODE": "1",
          "PYTHONUTF8": "1"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "BMS: resources",
      "type": "process",
      "command": "python",
      "args": [
        "bms_tools/bms.py",
        "--product",
        "${input:product}",
        "resources"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONDONTWRITEBYTECODE": "1",
          "PYTHONUTF8": "1"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "BMS: static",
      "type": "process",
      "command": "python",
      "args": [
        "bms_tools/bms.py",
        "--product",
        "${input:product}",
        "static",
        "--no-report"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONDONTWRITEBYTECODE": "1",
          "PYTHONUTF8": "1"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "BMS: all products link",
      "type": "process",
      "command": "python",
      "args": [
        "bms_tools/bms.py",
        "--all-products",
        "link",
        "--jobs",
        "4"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "product",
      "type": "pickString",
      "description": "BMS product",
      "options": [
        "d008",
        "d011",
        "d013",
        "d014"
      ],
      "default": "d014"
    }
  ]
}
