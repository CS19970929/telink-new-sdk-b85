<Window x:Class="TelinkOta.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Telink B85m BLE OTA 工具"
        Width="1100" Height="760"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- 顶部：设备扫描 + 固件/设置 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- 设备列表 -->
            <GroupBox Grid.Column="0" Header="设备" Margin="0,0,5,0">
                <DockPanel Margin="5">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                        <Button Content="扫描" Width="62" DockPanel.Dock="Left" Click="ScanButton_Click"/>
                        <Button Content="停止" Width="62" DockPanel.Dock="Left" Margin="5,0,0,0" Click="StopScanButton_Click"/>
                        <Button Content="连接" Width="62" DockPanel.Dock="Right" IsEnabled="{Binding CanConnectBattery}" Click="ConnectBatteryButton_Click"/>
                        <Button Content="断开" Width="62" DockPanel.Dock="Right" Margin="0,0,5,0" IsEnabled="{Binding BatteryConnected}" Click="DisconnectBatteryButton_Click"/>
                        <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="按名称/地址过滤（默认 BT_）"/>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding FilteredDevices}" SelectedItem="{Binding SelectedDevice}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                        <TextBlock Text="  "/>
                                        <TextBlock Text="{Binding AddressHex}" Foreground="Gray"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Rssi, StringFormat={}{0} dBm}" Foreground="Gray"/>
                                        <TextBlock Text="  "/>
                                        <TextBlock Text="{Binding Connectable, StringFormat={}{0}}" Foreground="Gray"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </GroupBox>

            <!-- 固件与设置 -->
            <GroupBox Grid.Column="1" Header="固件与设置" Margin="5,0,0,0">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="固件 BIN:" VerticalAlignment="Center" Grid.Row="0"/>
                    <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,2">
                        <Button Content="选择..." DockPanel.Dock="Right" Width="70" Click="PickFirmwareButton_Click"/>
                        <TextBox Text="{Binding FirmwarePath, Mode=OneWay}" IsReadOnly="True" VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBlock Text="协议:" VerticalAlignment="Center" Grid.Row="1"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2" SelectedIndex="{Binding ProtocolIndex}">
                        <ComboBoxItem Content="Auto（优先 Extend，回退 Legacy）"/>
                        <ComboBoxItem Content="Extend"/>
                        <ComboBoxItem Content="Legacy"/>
                    </ComboBox>

                    <TextBlock Text="PDU 长度:" VerticalAlignment="Center" Grid.Row="2"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,2"
                              ItemsSource="{Binding PduOptions}" SelectedItem="{Binding PduLength}"/>

                    <TextBlock Text="发送窗口:" VerticalAlignment="Center" Grid.Row="3"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,2" Text="{Binding WriteWindow}"/>

                    <TextBlock Text="尾包补齐:" VerticalAlignment="Center" Grid.Row="4"/>
                    <CheckBox Grid.Row="4" Grid.Column="1" Margin="0,4"
                              Content="补齐到完整 PDU（默认：16 的倍数，官方 App 行为）"
                              IsChecked="{Binding PadToFullPdu}"/>

                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                        <CheckBox Content="版本复核（重启后读 BMS 版本）" IsChecked="{Binding VerifyVersion}" Margin="0,0,12,0"/>
                        <CheckBox Content="版本比较（拒绝降级）" IsChecked="{Binding VersionCompare}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                        <CheckBox Content="工程模式（详细日志）" IsChecked="{Binding EngineeringMode}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                        <Button Content="开始 OTA" Width="120" Height="32" IsEnabled="{Binding CanStart}" Click="StartOtaButton_Click"/>
                        <Button Content="取消" Width="80" Height="32" Margin="8,0,0,0" IsEnabled="{Binding CanCancel}" Click="CancelOtaButton_Click"/>
                    </StackPanel>

                    <TextBlock Text="提示：设备默认 MTU=23，仅支持 PDU=16；更大 PDU 需固件启用大 MTU（app_config.h 修改 MTU_SIZE_SETTING）。" 
                               Grid.Row="8" Grid.ColumnSpan="2" Margin="0,4" Foreground="Gray" TextWrapping="Wrap"/>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- 进度 -->
        <GroupBox Grid.Row="1" Header="进度" Margin="0,8,0,4">
            <StackPanel Margin="6">
                <TextBlock Text="{Binding Status}" FontWeight="Bold" Margin="0,0,0,4"/>
                <ProgressBar Height="22" Maximum="100" Value="{Binding ProgressPercent}"/>
                <TextBlock Text="{Binding ProgressText}" Foreground="Gray" Margin="0,3,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- 电池状态 -->
        <GroupBox Grid.Row="2" Header="电池状态" Margin="0,4">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="{Binding BatteryStateText}" FontWeight="Bold" Foreground="DodgerBlue"/>
                    <TextBlock Text="{Binding SerialText, StringFormat=序列号: {0}}" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding HwVersionText, StringFormat=硬件版本: {0}}"/>
                    <TextBlock Text="{Binding SwVersionText, StringFormat=软件版本: {0}}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="{Binding PackVoltageText, StringFormat=总压: {0}}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding PackCurrentText, StringFormat=电流: {0}}" FontWeight="Bold" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding SocText, StringFormat=SOC: {0}}" FontWeight="Bold" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="{Binding TempsText, StringFormat=温度: {0}}"/>
                    <TextBlock Text="{Binding CellRangeText, StringFormat=单体: {0}}" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding StatusWordText, StringFormat=状态字: {0}}" Margin="0,3,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding CellsText}" TextWrapping="Wrap" Foreground="Gray"/>
            </Grid>
        </GroupBox>

        <!-- 日志 -->
        <GroupBox Grid.Row="3" Header="日志" Margin="0,4,0,0">            <TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     TextChanged="LogBox_TextChanged"/>
        </GroupBox>
    </Grid>
</Window>
