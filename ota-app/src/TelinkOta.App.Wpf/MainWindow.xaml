<Window x:Class="TelinkOta.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Telink B85m BLE 电池上位机"
        Width="1180" Height="820"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="0,0,0,6">

            <!-- ============ 页1：电池信息 ============ -->
            <TabItem Header="电池信息">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左：设备列表 -->
                    <GroupBox Grid.Column="0" Header="设备" Margin="0,0,6,0">
                        <DockPanel Margin="5">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                                <Button Content="扫描" Width="58" DockPanel.Dock="Left" Click="ScanButton_Click"/>
                                <Button Content="停止" Width="58" DockPanel.Dock="Left" Margin="4,0,0,0" Click="StopScanButton_Click"/>
                                <Button Content="连接" Width="58" DockPanel.Dock="Right" IsEnabled="{Binding CanConnectBattery}" Click="ConnectBatteryButton_Click"/>
                                <Button Content="断开" Width="58" DockPanel.Dock="Right" Margin="0,0,4,0" IsEnabled="{Binding BatteryConnected}" Click="DisconnectBatteryButton_Click"/>
                                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="按名称/地址过滤（默认 BT_）"/>
                            </DockPanel>
                            <ListBox ItemsSource="{Binding FilteredDevices}" SelectedItem="{Binding SelectedDevice}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                                <TextBlock Text="  "/>
                                                <TextBlock Text="{Binding AddressHex}" Foreground="Gray"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Rssi, StringFormat={}{0} dBm}" Foreground="Gray"/>
                                                <TextBlock Text="  "/>
                                                <TextBlock Text="{Binding Connectable, StringFormat={}{0}}" Foreground="Gray"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </GroupBox>

                    <!-- 右：电池数据 -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6,0,0,0">

                            <GroupBox Header="设备信息">
                                <Grid Margin="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding BatteryStateText}" FontWeight="Bold" Foreground="DodgerBlue"/>
                                        <TextBlock Text="{Binding MacText, StringFormat=MAC: {0}}" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding BtNameText, StringFormat=蓝牙名: {0}}"/>
                                        <DockPanel Margin="0,4,8,0">
                                            <Button Content="修改蓝牙名" Width="82" DockPanel.Dock="Right"
                                                    IsEnabled="{Binding CanChangeBluetoothName}"
                                                    Click="ChangeBluetoothNameButton_Click"/>
                                            <TextBox Text="{Binding NewBluetoothName, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,6,0" MaxLength="24"
                                                     ToolTip="输入 BT_完整名称或后缀；仅允许字母、数字、_、-"/>
                                        </DockPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding SerialText, StringFormat=序列号: {0}}"/>
                                        <TextBlock Text="{Binding HwVersionText, StringFormat=硬件版本: {0}}"/>
                                        <TextBlock Text="{Binding SwVersionText, StringFormat=软件版本: {0}}"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="实时数据" Margin="0,6,0,0">
                                <StackPanel>
                                    <Grid Margin="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="总压" Foreground="Gray"/>
                                            <TextBlock Text="{Binding PackVoltageText}" FontWeight="Bold" FontSize="16"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="电流" Foreground="Gray"/>
                                            <TextBlock Text="{Binding PackCurrentText}" FontWeight="Bold" FontSize="16"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="SOC" Foreground="Gray"/>
                                            <TextBlock Text="{Binding SocText}" FontWeight="Bold" FontSize="16"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="SOH" Foreground="Gray"/>
                                            <TextBlock Text="{Binding SohText}" FontWeight="Bold" FontSize="16"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Margin="6,4,6,6">
                                        <TextBlock Text="{Binding CurrentsText}"/>
                                        <TextBlock Text="{Binding CapacityText}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding CyclesText, StringFormat=循环次数: {0}}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="温度" Margin="0,6,0,0">
                                <StackPanel Margin="6">
                                    <TextBlock Text="{Binding TempsText}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding TempsListText}" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="Gray"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="单体电压" Margin="0,6,0,0">
                                <StackPanel Margin="6">
                                    <TextBlock Text="{Binding CellRangeText}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding CellPosText}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding CellsText}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="Gray"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="状态与故障" Margin="0,6,0,0">
                                <StackPanel Margin="6">
                                    <TextBlock Text="{Binding StatusWordText, StringFormat=状态字: {0}}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding StatusBitsText, StringFormat=位标志: {0}}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding FaultText, StringFormat=故障标志: {0}}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding BalanceText, StringFormat={}{0}}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="保护参数" Margin="0,6,0,0">
                                <TextBlock Text="{Binding ProtectText}" Margin="6" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                            </GroupBox>

                            <GroupBox Header="故障记录 (0xD100~0xD114)" Margin="0,6,0,0">
                                <TextBlock Text="{Binding FaultRecordsText}" Margin="6" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============ 页2：OTA 升级 ============ -->
            <TabItem Header="OTA 升级">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 设备列表（与电池页共享选择） -->
                    <GroupBox Grid.Column="0" Header="设备（与电池页共用）" Margin="0,0,6,0">
                        <DockPanel Margin="5">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                                <Button Content="扫描" Width="62" DockPanel.Dock="Left" Click="ScanButton_Click"/>
                                <Button Content="停止" Width="62" DockPanel.Dock="Left" Margin="5,0,0,0" Click="StopScanButton_Click"/>
                                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="按名称/地址过滤（默认 BT_）"/>
                            </DockPanel>
                            <ListBox ItemsSource="{Binding FilteredDevices}" SelectedItem="{Binding SelectedDevice}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                                <TextBlock Text="  "/>
                                                <TextBlock Text="{Binding AddressHex}" Foreground="Gray"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Rssi, StringFormat={}{0} dBm}" Foreground="Gray"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </GroupBox>

                    <!-- 固件与设置 -->
                    <GroupBox Grid.Column="1" Header="固件与设置" Margin="6,0,0,0">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="固件 BIN:" VerticalAlignment="Center" Grid.Row="0"/>
                            <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,2">
                                <Button Content="选择..." DockPanel.Dock="Right" Width="70" Click="PickFirmwareButton_Click"/>
                                <TextBox Text="{Binding FirmwarePath, Mode=OneWay}" IsReadOnly="True" VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock Text="协议:" VerticalAlignment="Center" Grid.Row="1"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2" SelectedIndex="{Binding ProtocolIndex}">
                                <ComboBoxItem Content="Auto（优先 Extend，回退 Legacy）"/>
                                <ComboBoxItem Content="Extend"/>
                                <ComboBoxItem Content="Legacy"/>
                            </ComboBox>

                            <TextBlock Text="PDU 长度:" VerticalAlignment="Center" Grid.Row="2"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,2"
                                      ItemsSource="{Binding PduOptions}" SelectedItem="{Binding PduLength}"/>

                            <TextBlock Text="发送窗口:" VerticalAlignment="Center" Grid.Row="3"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,2" Text="{Binding WriteWindow}"/>

                            <TextBlock Text="尾包补齐:" VerticalAlignment="Center" Grid.Row="4"/>
                            <CheckBox Grid.Row="4" Grid.Column="1" Margin="0,4"
                                      Content="补齐到完整 PDU（默认：16 的倍数，官方 App 行为）"
                                      IsChecked="{Binding PadToFullPdu}"/>

                            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                <CheckBox Content="版本复核（重启后读 BMS 版本）" IsChecked="{Binding VerifyVersion}" Margin="0,0,12,0"/>
                                <CheckBox Content="版本比较（拒绝降级）" IsChecked="{Binding VersionCompare}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                                <Button Content="开始 OTA" Width="120" Height="32" IsEnabled="{Binding CanStart}" Click="StartOtaButton_Click"/>
                                <Button Content="取消" Width="80" Height="32" Margin="8,0,0,0" IsEnabled="{Binding CanCancel}" Click="CancelOtaButton_Click"/>
                            </StackPanel>

                            <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,6">
                                <TextBlock Text="{Binding Status}" FontWeight="Bold"/>
                                <ProgressBar Height="20" Maximum="100" Value="{Binding ProgressPercent}" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding ProgressText}" Foreground="Gray" Margin="0,3,0,0"/>
                            </StackPanel>

                            <TextBlock Text="提示：设备默认 MTU=23，仅支持 PDU=16；更大 PDU 需固件启用大 MTU（app_config.h 修改 MTU_SIZE_SETTING）。"
                                       Grid.Row="8" Grid.ColumnSpan="2" Margin="0,4" Foreground="Gray" TextWrapping="Wrap"/>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 日志（两个页面共享） -->
        <GroupBox Grid.Row="1" Header="日志">
            <TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     TextChanged="LogBox_TextChanged"/>
        </GroupBox>
    </Grid>
</Window>
